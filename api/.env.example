# =====================================================================
# Reelix API - environment template
# Copy to api/.env and fill in. Never commit the completed file.
# =====================================================================

NODE_ENV=development
PORT=8080
APP_NAME=Reelix

# ---------------------------------------------------------------------
# Data provider
#   memory -> in-process store, no cloud resource required (local only)
#   sql    -> Azure SQL Database
# ---------------------------------------------------------------------
DATA_PROVIDER=memory

SQL_SERVER=reelix-sql-xxxxxx.database.windows.net
SQL_DATABASE=reelix-db
SQL_USER=reelixadmin
SQL_PASSWORD=
SQL_ENCRYPT=true
# Serverless Azure SQL resumes from auto-pause slowly on the first call.
SQL_CONNECT_TIMEOUT_MS=60000
SQL_REQUEST_TIMEOUT_MS=45000
SQL_POOL_MAX=8

# ---------------------------------------------------------------------
# Object storage
#   local -> ./.localstore on disk (local only)
#   azure -> Azure Blob Storage
# ---------------------------------------------------------------------
STORAGE_PROVIDER=local

STORAGE_ACCOUNT=
STORAGE_KEY=
# Alternatively supply a full connection string instead of account + key.
STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER=clips
STORAGE_LOCAL_ROOT=.localstore
# Lifetime of each playback SAS token, in minutes.
PLAYBACK_SAS_MINUTES=30

# ---------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=28800
BCRYPT_ROUNDS=10
MIN_PASSWORD_LENGTH=8

# ---------------------------------------------------------------------
# Azure AI Content Safety (free F0 tier)
# Leave blank to fall back to the local rule set.
# ---------------------------------------------------------------------
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
CONTENT_SAFETY_API_VERSION=2024-09-01
# FourSeverityLevels scale: 0, 2, 4, 6
CONTENT_SAFETY_FLAG_SEVERITY=2
CONTENT_SAFETY_BLOCK_SEVERITY=4

# ---------------------------------------------------------------------
# Caching, uploads, CORS and rate limiting
# ---------------------------------------------------------------------
CACHE_DASHBOARD_TTL=45
CACHE_SEARCH_TTL=30
CACHE_LOOKUP_TTL=600
CACHE_MAX_ENTRIES=500

MAX_UPLOAD_MB=64
ALLOWED_UPLOAD_TYPES=video/mp4,video/webm,video/quicktime

# Comma separated. Use the static website URL in Azure; '*' locally.
CORS_ORIGINS=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_CREDENTIAL_MAX=12

# ---------------------------------------------------------------------
# Seed accounts (used by npm run db:seed)
# ---------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@reelix.app
SEED_ADMIN_PASSWORD=
SEED_CREATOR_EMAIL=creator@reelix.app
SEED_CREATOR_PASSWORD=
SEED_CONSUMER_EMAIL=viewer@reelix.app
SEED_CONSUMER_PASSWORD=
